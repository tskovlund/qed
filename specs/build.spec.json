{
  "$schema": "../docs/spec.schema.json",
  "name": "build-integrity",
  "criteria": [
    {
      "description": "Project compiles with zero errors",
      "verify": {
        "type": "command",
        "run": "lake build"
      }
    },
    {
      "description": "All tests pass",
      "verify": {
        "type": "command",
        "run": "lake test"
      }
    },
    {
      "description": "No sorry in proof or source files",
      "verify": {
        "type": "command",
        "run": "! grep -rn '\\bsorry\\b' --include='*.lean' Qed/ Tests/ DocGen/ Main.lean 2>/dev/null | grep -v '^\\s*--' | grep -v '\".*sorry.*\"' | grep -q ."
      }
    },
    {
      "description": "Markdown formatting is consistent (prettier)",
      "verify": {
        "type": "command",
        "run": "npx prettier@3 --check ."
      }
    }
  ]
}
