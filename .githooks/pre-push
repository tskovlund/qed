#!/usr/bin/env bash
# Build qed and verify all specs before push.
# All checks (tests, sorry, docs freshness) are spec criteria —
# qed verifies itself.

# Ensure lake is available (via devbox/elan)
if ! command -v lake &>/dev/null; then
  if command -v devbox &>/dev/null; then
    eval "$(devbox shellenv 2>/dev/null)"
  fi
fi

echo "pre-push: building..."
lake build || exit 1

# Redirect stdin from terminal — git uses stdin for ref data,
# but human criteria need interactive input.
exec < /dev/tty

echo "pre-push: verifying specs..."
.lake/build/bin/qed verify --auto --pin || exit 1
