#!/usr/bin/env bash
# Run build and tests before push.

# Ensure lake is available (via devbox/elan)
if ! command -v lake &>/dev/null; then
  if command -v devbox &>/dev/null; then
    eval "$(devbox shellenv 2>/dev/null)"
  fi
fi

echo "pre-push: building..."
lake build || exit 1

echo "pre-push: running tests..."
lake test || exit 1

echo "pre-push: checking for sorry..."
if grep -rn 'sorry' --include='*.lean' Qed/ Tests/ DocGen/ Main.lean 2>/dev/null | grep -v '^--' | grep -v '^\s*--'; then
  echo "pre-push: found 'sorry' in source files"
  exit 1
fi
